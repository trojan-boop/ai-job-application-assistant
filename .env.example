# Copy to .env and adjust values
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-secret

# ── AI provider (pick ONE free option below) ─────────────────────────────
# Auto mode prefers free providers: Groq → Gemini → OpenAI
# Set LLM_PROVIDER=groq|gemini|openai to force a specific provider
LLM_PROVIDER=auto

# Option A — Groq (FREE, recommended for demo)
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option B — Google Gemini (FREE)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Option C — OpenAI (paid, requires billing)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
